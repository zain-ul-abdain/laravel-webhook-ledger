# Normalise line endings in the repo to LF regardless of the machine that commits.
* text=auto eol=lf

# Keep the distributed package lean — none of this belongs in `composer require`.
/.github        export-ignore
/tests          export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/Dockerfile     export-ignore
/docker-compose.yml export-ignore
/phpunit.xml    export-ignore
